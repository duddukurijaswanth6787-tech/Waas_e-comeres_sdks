# ==============================================================================
# BOUTIQUE PLATFORM: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Central Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boutique_saas?schema=public"

# Super Admin JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
SUPER_ADMIN_EMAIL="admin@boutiqueplatform.com"
SUPER_ADMIN_PASSWORD_HASH="$2b$10$defaultHashForAdminInitialization123"

# Cloudflare R2 / AWS S3 Storage (Object Storage for Boutique Media)
R2_ACCOUNT_ID="your_cloudflare_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="boutique-media-prod"
R2_PUBLIC_DOMAIN="https://media.yourplatform.com"

# Payment Gateway (Razorpay India - UPI / Cards / AutoPay)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# WhatsApp Automated Reminders (Interakt / Wati / Twilio)
WHATSAPP_API_URL="https://api.interakt.ai/v1"
WHATSAPP_API_KEY="your_whatsapp_provider_api_key"

# SDK Public Distribution URL
SDK_CDN_URL="http://localhost:4000/sdk/v1/boutique-sdk.min.js"
